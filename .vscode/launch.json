{
  "version": "0.2.0",
  "configurations": [
    {
      // REQUIRED: reemplazar NOMBRE_DEL_EJECUTABLE por el binario que
      // genera tu Makefile (el nombre después de "-o" en la regla de
      // build, p.ej. "run_tests", "hive", "anagrama1"). El placeholder es
      // intencional: no apunta a ningún binario real, así que F5 falla
      // hasta que lo completes en vez de debuggear el ejecutable
      // equivocado en silencio.
      "name": "gdb: NOMBRE_DEL_EJECUTABLE",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/NOMBRE_DEL_EJECUTABLE",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "make build"
    }
  ]
}
